        <ui:VisualElement name="UpgradeButton" class="button" style="width: 100%; height: 60%; align-items: center; justify-content: center; align-self: center; margin-top: 5%; margin-right: 5%; margin-bottom: 5%; margin-left: 5%; background-image: url(&quot;project://database/Assets/Art/Placeholder/UIIcons/upgradeIcon2.png?fileID=2800000&amp;guid=e289a816c60ade3489f26374c53f20ce&amp;type=3#upgradeIcon2&quot;); -unity-background-scale-mode: scale-to-fit; top: 10%;" />
